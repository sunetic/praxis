{
  "suite": "praxis-pg-dba",
  "version": "1.0.0",
  "cases": [
    {
      "id": "C01",
      "title": "Estate health baseline",
      "prompt": "你刚接手这个 PostgreSQL 实例。请做一轮有证据的健康基线，至少覆盖对象/容量、连接与事务、索引使用、vacuum 状态；给出按风险排序的结论，并明确不确定性。只读，不做任何变更。",
      "minimum_sql_calls": 4,
      "answer_checks": [
        {"id": "objects", "description": "covers objects or capacity", "patterns": ["对象|容量|表大小|pg_total_relation_size"], "weight": 15},
        {"id": "connections", "description": "covers connections and transactions", "patterns": ["连接|事务|pg_stat_activity"], "weight": 15},
        {"id": "indexes", "description": "covers index usage", "patterns": ["索引|index"], "weight": 15},
        {"id": "vacuum", "description": "covers vacuum state", "patterns": ["vacuum|死元组|dead tuple"], "weight": 15},
        {"id": "uncertainty", "description": "states uncertainty", "patterns": ["不确定|仍需|需要进一步|无法确认|局限"], "weight": 10}
      ]
    },
    {
      "id": "C02",
      "title": "Slow order dashboard",
      "prompt": "订单状态看板最近明显变慢。请定位过去 30 天 refunded/pending/cancelled/shipped 汇总查询的主要瓶颈，用安全的执行计划证据验证，并提出索引方案、写放大/存储代价和上线验证步骤。不要执行 DDL。",
      "minimum_sql_calls": 2,
      "answer_checks": [
        {"id": "plan", "description": "uses an execution plan", "patterns": ["EXPLAIN|执行计划|Seq Scan|顺序扫描"], "weight": 20},
        {"id": "predicate", "description": "uses the actual time and status predicate", "patterns": ["30 天|30天|created_at.*status|status.*created_at"], "weight": 15},
        {"id": "index", "description": "recommends a composite or partial index", "patterns": ["复合索引|组合索引|部分索引|partial index|\\(status,\\s*created_at\\)|\\(created_at,\\s*status\\)"], "weight": 20},
        {"id": "tradeoff", "description": "states write or storage tradeoffs", "patterns": ["写放大|写入成本|存储|维护成本"], "weight": 10},
        {"id": "validation", "description": "provides rollout validation", "patterns": ["验证|灰度|回滚|上线"], "weight": 10}
      ]
    },
    {
      "id": "C03",
      "title": "Blocking chain",
      "prompt": "线上写入正在停顿。请查清当前 PostgreSQL 阻塞链：根阻塞者、等待者、持续时间、用户、application_name、SQL 与涉及对象；按风险给出最安全的处置顺序。只诊断，不 cancel/terminate。",
      "minimum_sql_calls": 1,
      "answer_checks": [
        {"id": "holder", "description": "identifies the root blocker", "patterns": ["praxis_lock_holder"], "weight": 25},
        {"id": "waiter", "description": "identifies the waiter", "patterns": ["checkout_api_waiter"], "weight": 25},
        {"id": "chain_evidence", "description": "provides blocking evidence", "patterns": ["pg_blocking_pids|阻塞链|根阻塞"], "weight": 15},
        {"id": "safe_order", "description": "gives a safe response order", "patterns": ["审批|先.*确认|不要.*terminate|不.*终止|只诊断"], "weight": 15}
      ]
    },
    {
      "id": "C04",
      "title": "Connection and transaction pressure",
      "prompt": "评估当前连接池是否接近耗尽，并检查 idle in transaction 风险。把实际连接数与 max_connections 对比，按 application_name/状态归因，指出长事务及其危害；给出可操作建议但不要杀连接。",
      "minimum_sql_calls": 2,
      "answer_checks": [
        {"id": "maximum", "description": "compares with max_connections", "patterns": ["max_connections|最大连接"], "weight": 20},
        {"id": "idle_tx", "description": "finds the two idle transactions", "patterns": ["2.*legacy_billing_idle_tx|legacy_billing_idle_tx.*2|两个.*idle in transaction|2.*idle in transaction"], "weight": 25},
        {"id": "reporting", "description": "attributes reporting pool connections", "patterns": ["reporting_pool"], "weight": 20},
        {"id": "hygiene", "description": "separates capacity from transaction hygiene", "patterns": ["未.*耗尽|不.*接近耗尽|连接压力.*事务|事务卫生|长事务"], "weight": 15}
      ]
    },
    {
      "id": "C05",
      "title": "Vacuum and bloat triage",
      "prompt": "审计所有业务表的 vacuum 健康和膨胀信号：dead tuples、比例、最近 vacuum/autovacuum、表级 autovacuum 设置。请找出最需要处理的表，给出低风险处置顺序与仍需验证的事项；不要执行 VACUUM 或改参数。",
      "minimum_sql_calls": 2,
      "answer_checks": [
        {"id": "target", "description": "identifies operations.work_queue", "patterns": ["operations\\.work_queue|work_queue"], "weight": 25},
        {"id": "disabled", "description": "finds disabled autovacuum", "patterns": ["autovacuum_enabled.*false|autovacuum.*禁用|禁用.*autovacuum"], "weight": 25},
        {"id": "dead", "description": "reports material dead tuples", "patterns": ["dead tuple|dead tuples|死元组|n_dead_tup"], "weight": 15},
        {"id": "caution", "description": "does not equate estimates with exact bloat", "patterns": ["估算|信号|不能.*等同|仍需.*验证|pgstattuple"], "weight": 15}
      ]
    },
    {
      "id": "C06",
      "title": "Index portfolio audit",
      "prompt": "做一次 PostgreSQL 索引组合审计：找出真正重复/冗余、无效或低价值索引，同时结合近期查询与执行计划找出高价值缺失索引。不要只看索引名，也不要执行 DDL。输出保留/候选删除/候选新增及证据。",
      "minimum_sql_calls": 3,
      "answer_checks": [
        {"id": "duplicate_a", "description": "finds first duplicate payment index", "patterns": ["payments_reference_idx"], "weight": 20},
        {"id": "duplicate_b", "description": "finds second duplicate payment index", "patterns": ["payments_reference_duplicate_idx"], "weight": 20},
        {"id": "definition", "description": "compares definitions rather than names", "patterns": ["定义|key columns|列.*谓词|pg_get_indexdef|indkey"], "weight": 15},
        {"id": "portfolio", "description": "classifies retain, remove and add candidates", "patterns": ["保留.*候选删除.*候选新增|候选删除|候选新增"], "weight": 15},
        {"id": "tradeoff", "description": "uses workload or write tradeoffs", "patterns": ["写放大|写入成本|使用次数|idx_scan|工作负载"], "weight": 10}
      ]
    },
    {
      "id": "C07",
      "title": "Planner estimation and statistics",
      "prompt": "调查 enterprise + APAC 客户关联订单聚合的执行计划是否有明显估算偏差。比较 estimated/actual rows，检查相关列统计信息与统计新鲜度，解释根因并给出扩展统计或其他方案的验证步骤。只读。",
      "minimum_sql_calls": 3,
      "answer_checks": [
        {"id": "analyzed_plan", "description": "uses a safe analyzed plan", "patterns": ["EXPLAIN.*ANALYZE|实际.*行|actual rows"], "weight": 20},
        {"id": "estimate", "description": "compares estimated and actual rows", "patterns": ["估算.*实际|estimated.*actual|rows=.*rows="], "weight": 20},
        {"id": "correlation", "description": "recognizes segment/region correlation", "patterns": ["相关性|关联|segment.*region|region.*segment"], "weight": 20},
        {"id": "freshness", "description": "checks statistics freshness", "patterns": ["统计.*新鲜|last_analyze|ANALYZE|统计信息"], "weight": 10},
        {"id": "validation", "description": "proposes validating extended statistics", "patterns": ["CREATE STATISTICS|扩展统计.*验证|验证.*扩展统计"], "weight": 10}
      ]
    },
    {
      "id": "C08",
      "title": "Payment data quality reconciliation",
      "prompt": "财务对账发现异常。请实际核查 payments 的孤儿 order/customer 引用、重复 payment_reference、负金额、异常 currency 和未知状态；给出每类准确计数、少量样例 ID、规则假设以及修复前的防护建议。只读，不更新数据。",
      "minimum_sql_calls": 5,
      "answer_checks": [
        {"id": "orphan_orders", "description": "exact orphan order count", "patterns": ["1[,，]?658|1658"], "weight": 15},
        {"id": "orphan_customers", "description": "exact orphan customer count", "patterns": ["3[,，]?465|3465"], "weight": 15},
        {"id": "duplicate_references", "description": "exact duplicate reference count", "patterns": ["516"], "weight": 15},
        {"id": "negative_amounts", "description": "exact negative amount count", "patterns": ["351"], "weight": 15},
        {"id": "currency", "description": "exact anomalous currency count", "patterns": ["701"], "weight": 10},
        {"id": "status", "description": "exact unknown status count", "patterns": ["582"], "weight": 10},
        {"id": "samples", "description": "includes sample identifiers", "patterns": ["样例|示例|sample|payment_id"], "weight": 5}
      ]
    },
    {
      "id": "C09",
      "title": "Privilege and schema security",
      "prompt": "对当前 PostgreSQL 做最小权限审计：检查 LOGIN 角色的 superuser/CREATEDB/replication 属性、业务 schema 表级授权，以及 PUBLIC 对 public schema 的权限。指出具体违规，草拟可回滚的修复 SQL，但不要执行。",
      "minimum_sql_calls": 3,
      "answer_checks": [
        {"id": "vendor", "description": "identifies vendor_support", "patterns": ["vendor_support"], "weight": 20},
        {"id": "createdb", "description": "identifies CREATEDB violation", "patterns": ["CREATEDB|创建数据库"], "weight": 20},
        {"id": "broad_write", "description": "identifies broad commerce write access", "patterns": ["ALL PRIVILEGES|广泛.*写|过宽.*权限|commerce.*写"], "weight": 15},
        {"id": "public_create", "description": "identifies PUBLIC CREATE", "patterns": ["PUBLIC.*CREATE|CREATE.*PUBLIC|public schema.*CREATE"], "weight": 20},
        {"id": "remediation", "description": "drafts reversible remediation", "patterns": ["REVOKE|回滚|修复 SQL|修复SQL"], "weight": 10}
      ]
    },
    {
      "id": "C10",
      "title": "Knowledge-grounded incident decision",
      "prompt": "请结合“ACME PostgreSQL Production Incident Policy”知识库和当前数据库实时证据，判断眼下锁、连接事务、vacuum 三类风险各是什么严重级别，给出现在能做和必须审批后才能做的动作。逐条引用知识库章节，并把政策事实与数据库事实分开；有冲突或证据不足要明确说。不要执行处置。",
      "minimum_sql_calls": 3,
      "knowledge_required": true,
      "answer_checks": [
        {"id": "lock_policy", "description": "applies the blocking SEV-1 policy", "patterns": ["SEV-1|15 秒|15秒"], "weight": 15},
        {"id": "connection_policy", "description": "applies connection thresholds", "patterns": ["75%|90%|max_connections"], "weight": 10},
        {"id": "idle_policy", "description": "applies idle transaction threshold", "patterns": ["30 秒|30秒|idle in transaction"], "weight": 10},
        {"id": "vacuum_policy", "description": "applies vacuum red-zone policy", "patterns": ["50[,，]?000|50000|20%|红区|red zone"], "weight": 10},
        {"id": "live_lock", "description": "uses current lock evidence", "patterns": ["praxis_lock_holder|checkout_api_waiter"], "weight": 10},
        {"id": "live_vacuum", "description": "uses current work_queue evidence", "patterns": ["work_queue"], "weight": 10},
        {"id": "separation", "description": "separates policy and live evidence", "patterns": ["政策事实.*数据库事实|政策.*实时证据|知识库.*实时"], "weight": 10},
        {"id": "approval", "description": "separates immediate and approved actions", "patterns": ["必须审批|审批后|现在能做|立即可做"], "weight": 10}
      ]
    }
  ]
}
