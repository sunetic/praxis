# Praxis Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Application
# ===========================================
APP_NAME=Praxis
APP_ENV=development  # development | production
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# ===========================================
# Database
# ===========================================
DATABASE_URL=sqlite:///./praxis.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/praxis

# ===========================================
# AI Model (OpenAI Compatible)
# ===========================================
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-api-key-here
AI_MODEL=gpt-4
# Or use local models:
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3

# ===========================================
# Monitor DB (Collector 采集库，SQL 分析读取)
# ===========================================
MONITOR_DB_HOST=127.0.0.1
MONITOR_DB_PORT=2881
MONITOR_DB_USER=monitor
MONITOR_DB_PASSWORD=
MONITOR_DB_DATABASE=praxis_collector

# ===========================================
# Tracing (disabled by default)
# ===========================================
TRACING_ENABLED=false
# When enabled, sample rate must be chosen for the deployment's traffic volume.
TRACING_SAMPLE_RATE=0.1
TRACING_RETENTION_HOURS=24
TRACING_CLEANUP_INTERVAL_SECONDS=300
TRACING_EXCLUDED_URLS=/health

# ===========================================
# Frontend (Vite)
# ===========================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
